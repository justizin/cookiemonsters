{
  "version": "2026-10-11",
  "comment": "One entry per consent-management platform. All fields are CSS selectors (comma lists allowed). 'accept' selectors are never clicked; they are used to measure how prominent the reject button is. When a selector is missing or matches nothing, the engine falls back to the multilingual text classifier inside the rule's container. 'shadowHost' means the banner lives inside that element's open shadow root.",
  "cmps": [
    {"id": "onetrust", "detect": "#onetrust-banner-sdk, #onetrust-consent-sdk #onetrust-pc-sdk", "container": "#onetrust-consent-sdk",
     "rejectAll": "#onetrust-reject-all-handler", "settings": "#onetrust-pc-btn-handler, #onetrust-banner-sdk .ot-sdk-show-settings",
     "panel": "#onetrust-pc-sdk", "panelRejectAll": "#onetrust-pc-sdk .ot-pc-refuse-all-handler",
     "toggles": "#onetrust-pc-sdk input.category-switch-handler, #onetrust-pc-sdk .ot-tgl input[type=checkbox], #onetrust-pc-sdk input.ot-obj-leg-btn-handler",
     "save": "#onetrust-pc-sdk .save-preference-btn-handler", "accept": "#onetrust-accept-btn-handler, #accept-recommended-btn-handler"},
    {"id": "cookiebot", "detect": "#CybotCookiebotDialog", "container": "#CybotCookiebotDialog",
     "rejectAll": "#CybotCookiebotDialogBodyButtonDecline", "settings": "#CybotCookiebotDialogBodyLevelButtonCustomize, #CybotCookiebotDialogNavDetails",
     "panel": "#CybotCookiebotDialog",
     "toggles": "#CybotCookiebotDialog input.CybotCookiebotDialogBodyLevelButton, #CybotCookiebotDialog input[type=checkbox][data-category], #CybotCookiebotDialog .CybotCookiebotDialogBodyLevelButtonSlider ~ input",
     "save": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection, #CybotCookiebotDialogBodyButtonAcceptSelected",
     "accept": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll, #CybotCookiebotDialogBodyButtonAccept"},
    {"id": "didomi", "detect": "#didomi-notice, #didomi-popup", "container": "#didomi-host",
     "rejectAll": "#didomi-notice-disagree-button, .didomi-continue-without-agreeing", "settings": "#didomi-notice-learn-more-button",
     "panel": ".didomi-consent-popup-preferences, #didomi-consent-popup", "panelRejectAll": "#didomi-consent-popup button[aria-describedby*='disagree'], #didomi-consent-popup .didomi-consent-popup-disagree-to-all",
     "toggles": "#didomi-consent-popup button.didomi-components-radio__option--agree[aria-pressed=true]",
     "save": "#didomi-consent-popup .didomi-consent-popup-actions button.didomi-button-highlight, #didomi-consent-popup .didomi-consent-popup-footer button[class*=save]",
     "accept": "#didomi-notice-agree-button"},
    {"id": "quantcast", "detect": ".qc-cmp2-container", "container": ".qc-cmp2-container",
     "settings": ".qc-cmp2-summary-buttons button[mode=secondary]", "panel": ".qc-cmp2-container",
     "panelRejectAll": ".qc-cmp2-header-links button[mode=link]:first-child, .qc-cmp2-container button[class*=reject]",
     "toggles": ".qc-cmp2-container .qc-cmp2-toggle[aria-checked=true]", "save": ".qc-cmp2-footer button[mode=primary]",
     "accept": ".qc-cmp2-summary-buttons button[mode=primary]"},
    {"id": "sourcepoint", "detect": ".message-container .sp_choice_type_11, .message-container .sp_choice_type_12, .message-container .sp_choice_type_13", "container": ".message-container",
     "rejectAll": ".sp_choice_type_13, .sp_choice_type_REJECT_ALL", "settings": ".sp_choice_type_12",
     "accept": ".sp_choice_type_11"},
    {"id": "sourcepoint-pm", "detect": ".pm-main .pm-features, .privacy-manager-tcfv2, #notice.pm-main", "container": "body",
     "panelRejectAll": "button.sp_choice_type_REJECT_ALL, button[title='Reject All' i]", "save": "button.sp_choice_type_SAVE_AND_EXIT",
     "toggles": ".pm-main .switch-container input[type=checkbox], .pm-main .pur-toggle [aria-checked=true]", "accept": "button.sp_choice_type_ACCEPT_ALL"},
    {"id": "trustarc", "detect": "#truste-consent-track, #truste-consent-content", "container": "#truste-consent-track",
     "rejectAll": "#truste-consent-required", "settings": "#truste-show-consent", "accept": "#truste-consent-button"},
    {"id": "usercentrics", "shadowHost": "#usercentrics-root, #usercentrics-cmp-ui", "detect": "[data-testid=uc-default-banner], [data-testid=uc-banner-content], #uc-main-dialog, #uc-center-container",
     "rejectAll": "[data-testid=uc-deny-all-button], button#deny", "settings": "[data-testid=uc-more-button], button#more",
     "panelRejectAll": "[data-testid=uc-deny-all-button], button#deny", "save": "[data-testid=uc-save-button], button#save",
     "toggles": "input[type=checkbox][data-testid^=uc-category]:not(:disabled), [role=switch][aria-checked=true]",
     "accept": "[data-testid=uc-accept-all-button], button#accept"},
    {"id": "osano", "detect": ".osano-cm-dialog:not(.osano-cm-dialog--hidden)", "container": ".osano-cm-window",
     "rejectAll": ".osano-cm-denyAll, .osano-cm-dialog .osano-cm-deny", "settings": ".osano-cm-dialog .osano-cm-manage",
     "panel": ".osano-cm-info-dialog", "toggles": ".osano-cm-info-dialog input.osano-cm-toggle__input",
     "save": ".osano-cm-info-dialog .osano-cm-save", "accept": ".osano-cm-accept-all, .osano-cm-dialog .osano-cm-accept"},
    {"id": "cookieyes", "detect": ".cky-consent-container:not(.cky-hide)", "container": ".cky-consent-container",
     "rejectAll": ".cky-btn-reject", "settings": ".cky-btn-customize", "panel": ".cky-preference-center, .cky-modal",
     "panelRejectAll": ".cky-modal .cky-btn-reject", "toggles": ".cky-modal input[type=checkbox]",
     "save": ".cky-btn-preferences", "accept": ".cky-btn-accept"},
    {"id": "klaro", "detect": ".klaro .cookie-notice, .klaro .cookie-modal", "container": ".klaro",
     "rejectAll": ".klaro .cn-decline, .klaro .cm-btn-decline", "settings": ".klaro .cn-learn-more",
     "panel": ".klaro .cookie-modal", "toggles": ".klaro .cookie-modal input.cm-list-input:not(.required)",
     "save": ".klaro .cookie-modal .cm-btn-accept:not(.cm-btn-accept-all)", "accept": ".klaro .cm-btn-accept-all, .klaro .cn-accept"},
    {"id": "iubenda", "detect": "#iubenda-cs-banner", "container": "#iubenda-cs-banner",
     "rejectAll": ".iubenda-cs-reject-btn", "settings": ".iubenda-cs-customize-btn", "accept": ".iubenda-cs-accept-btn"},
    {"id": "complianz", "detect": ".cmplz-cookiebanner:not(.cmplz-hidden)", "container": ".cmplz-cookiebanner",
     "rejectAll": ".cmplz-cookiebanner .cmplz-deny", "settings": ".cmplz-cookiebanner .cmplz-view-preferences",
     "toggles": ".cmplz-cookiebanner input.cmplz-consent-checkbox", "save": ".cmplz-cookiebanner .cmplz-save-preferences",
     "accept": ".cmplz-cookiebanner .cmplz-accept"},
    {"id": "borlabs", "detect": "#BorlabsCookieBox ._brlbs-block-content, #BorlabsCookieBox ._brlbs-bar", "container": "#BorlabsCookieBox",
     "rejectAll": "#BorlabsCookieBox ._brlbs-refuse-btn a, #BorlabsCookieBox a._brlbs-refuse-btn, #BorlabsCookieBox ._brlbs-refuse a",
     "settings": "#BorlabsCookieBox ._brlbs-manage a, #BorlabsCookieBox a._brlbs-manage", "accept": "#BorlabsCookieBox ._brlbs-btn-accept-all"},
    {"id": "cookieconsent3", "detect": "#cc-main .cm, #cc-main .pm", "container": "#cc-main",
     "rejectAll": "#cc-main .cm [data-role=necessary]", "settings": "#cc-main .cm [data-role=show]",
     "panel": "#cc-main .pm", "panelRejectAll": "#cc-main .pm [data-role=necessary]", "save": "#cc-main .pm [data-role=save]",
     "toggles": "#cc-main .pm input.section__toggle", "accept": "#cc-main [data-role=all]"},
    {"id": "cookieconsent2", "detect": ".cc-window:not(.cc-invisible)", "container": ".cc-window",
     "rejectAll": ".cc-window .cc-deny", "accept": ".cc-window .cc-allow, .cc-window .cc-dismiss"},
    {"id": "funding-choices", "detect": ".fc-consent-root", "container": ".fc-consent-root",
     "rejectAll": ".fc-cta-do-not-consent", "settings": ".fc-cta-manage-options",
     "toggles": ".fc-consent-root input.fc-preference-consent, .fc-consent-root input.fc-preference-legitimate-interest",
     "save": ".fc-confirm-choices", "accept": ".fc-cta-consent"},
    {"id": "consentmanager", "detect": "#cmpbox, #cmpwrapper", "shadowHost": "#cmpwrapper", "container": "#cmpbox",
     "rejectAll": ".cmpboxbtnno, a.cmptxt_btn_no", "settings": ".cmpboxbtncustom, a.cmptxt_btn_custom",
     "save": ".cmpboxbtnsave, a.cmptxt_btn_save", "accept": ".cmpboxbtnyes, a.cmptxt_btn_yes"},
    {"id": "termly", "detect": "[data-tid=banner-decline], [data-tid=banner-accept]", "container": "[data-tid=banner-decline]",
     "rejectAll": "[data-tid=banner-decline]", "accept": "[data-tid=banner-accept]"},
    {"id": "axeptio", "detect": "#axeptio_overlay .axeptio_widget, #axeptio_main_button", "container": "#axeptio_overlay",
     "rejectAll": "#axeptio_btn_dismiss", "accept": "#axeptio_btn_acceptAll"},
    {"id": "tarteaucitron", "detect": "#tarteaucitronAlertBig", "container": "#tarteaucitronRoot",
     "rejectAll": "#tarteaucitronAllDenied2, #tarteaucitronAllDenied", "accept": "#tarteaucitronPersonalize2, #tarteaucitronAllAllowed"},
    {"id": "shopify", "detect": "#shopify-pc__banner", "container": "#shopify-pc__banner",
     "rejectAll": "#shopify-pc__banner__btn-decline", "settings": "#shopify-pc__banner__btn-manage-prefs",
     "panel": "#shopify-pc__prefs", "toggles": "#shopify-pc__prefs input[type=checkbox]", "save": "#shopify-pc__prefs__header-save",
     "accept": "#shopify-pc__banner__btn-accept"},
    {"id": "hubspot", "detect": "#hs-eu-cookie-confirmation", "container": "#hs-eu-cookie-confirmation",
     "rejectAll": "#hs-eu-decline-button", "accept": "#hs-eu-confirmation-button"},
    {"id": "cookiescript", "detect": "#cookiescript_injected", "container": "#cookiescript_injected",
     "rejectAll": "#cookiescript_reject", "settings": "#cookiescript_manage", "toggles": "#cookiescript_injected input[type=checkbox]",
     "save": "#cookiescript_save", "accept": "#cookiescript_accept"},
    {"id": "civic", "detect": "#ccc-notify, #ccc-module", "container": "#ccc",
     "rejectAll": "#ccc-notify-reject, #ccc-reject-settings", "settings": "#ccc-notify-dismiss, .ccc-notify-link",
     "toggles": "#ccc-module input[type=checkbox]", "save": "#ccc-dismiss-button, #ccc-close",
     "accept": "#ccc-notify-accept, #ccc-recommended-settings"},
    {"id": "wix", "detect": "[data-hook=consent-banner-root]", "container": "[data-hook=consent-banner-root]",
     "rejectAll": "[data-hook=consent-banner-decline-button]", "settings": "[data-hook=consent-banner-settings-button]",
     "accept": "[data-hook=consent-banner-apply-button]"}
  ]
}
